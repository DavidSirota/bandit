#!/bin/sh
# deskpet-state <mood>
# Writes a single mood word to the local state file the creature watches.
# Purely local. No network, ever. Written by any tool (e.g. an editor hook) to drive his mood.
#
# moods: idle | thinking | working | celebrate | alert | sleep
STATE_DIR="$HOME/.deskpet"
mkdir -p "$STATE_DIR"
printf '%s' "${1:-idle}" > "$STATE_DIR/state"
